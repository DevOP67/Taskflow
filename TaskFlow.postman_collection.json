{
  "info": {
    "name": "TaskFlow API",
    "description": "Complete API collection for TaskFlow — JWT Auth & Task CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"John Doe\",\"email\":\"john@example.com\",\"password\":\"Password123\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["const r = pm.response.json(); if(r.data?.token) pm.collectionVariables.set('token', r.data.token);"] }
          }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"john@example.com\",\"password\":\"Password123\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["const r = pm.response.json(); if(r.data?.token) pm.collectionVariables.set('token', r.data.token);"] }
          }]
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/profile",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/auth/change-password",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"currentPassword\":\"Password123\",\"newPassword\":\"NewPassword456\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tasks?page=1&limit=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "", "disabled": true },
                { "key": "priority", "value": "", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/tasks",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Fix critical bug\",\"description\":\"Login page crashes on mobile\",\"status\":\"IN_PROGRESS\",\"priority\":\"HIGH\",\"dueDate\":\"2024-12-31\"}"
            }
          }
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/tasks/:id",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "variable": [{ "key": "id", "value": "paste-task-id-here" }]
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/tasks/:id",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"COMPLETED\",\"priority\":\"LOW\"}"
            },
            "variable": [{ "key": "id", "value": "paste-task-id-here" }]
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/tasks/:id",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "variable": [{ "key": "id", "value": "paste-task-id-here" }]
          }
        },
        {
          "name": "Get Task Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/tasks/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users?page=1&limit=10",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/:id",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "variable": [{ "key": "id", "value": "paste-user-id-here" }]
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/users/:id/role",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"role\":\"ADMIN\"}" },
            "variable": [{ "key": "id", "value": "paste-user-id-here" }]
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/users/:id",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "variable": [{ "key": "id", "value": "paste-user-id-here" }]
          }
        }
      ]
    }
  ]
}
